HOST=127.0.0.1
PORT=8787
ADMIN_PASSWORD=change-me
SESSION_SECRET=change-me-to-16+chars
DATA_DIR=./data
COOKIE_SECURE=false
# Production behind HTTPS: COOKIE_SECURE=true
# Local `npm start`: absolute path on this machine to a read-only deploy key.
# GIT_SSH_KEY=
# Docker: do not put a host path here. Use compose.ssh.yaml
# (GIT_SSH_KEY=/run/secrets/git_ssh and bind ./secrets/git_ssh).
